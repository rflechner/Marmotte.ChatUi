@page "/workspace"
@attribute [Authorize]
@inject IServiceProvider Services

<PageTitle>Your workspace — Marmotte.ChatUi</PageTitle>

<main class="workspace-page">
    <h1>Your workspace</h1>
    <AuthorizeView>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
    </AuthorizeView>
    <p><strong>Experimental POC — not production-ready.</strong></p>
    @if (Services.GetService<Marmotte.ChatUi.Application.ChatService>() is not null)
    {
        <ChatWorkspace />
    }
    else
    {
        <p>Chat storage is not configured. Start the application through Aspire to connect PostgreSQL.</p>
    }
    <form action="/account/logout" method="post" data-enhance="false">
        <AntiforgeryToken />
        <button type="submit">Sign out</button>
    </form>
</main>
