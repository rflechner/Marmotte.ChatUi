@page "/"
@attribute [AllowAnonymous]
@inject IdentityAvailability Identity

<PageTitle>Marmotte.ChatUi</PageTitle>

<main class="foundation">
    <img class="mascot" src="images/marmotte-chatui-mascot.png" alt="Turquoise marmot mascot with a red scarf" width="240" height="240" />
    <h1>Marmotte.ChatUi</h1>
    <p><strong>Experimental POC — not production-ready.</strong></p>
    <h2>A reusable conversation surface</h2>
    <p>Sign in, configure a model connection, and chat with saved history, streamed responses and reusable themed components.</p>
    @if (Identity.IsConfigured)
    {
        <a href="/account/login" data-enhance-nav="false">Sign in to your workspace</a>
    }
    else
    {
        <p>Sign-in is not configured. Start the application through Aspire to use the local identity provider.</p>
    }
</main>
