@page "/account/error"
@attribute [AllowAnonymous]

<PageTitle>Sign-in unavailable — Marmotte.ChatUi</PageTitle>

<main class="foundation">
    <h1>We could not complete authentication</h1>
    <p>The request may have expired or the identity service may be unavailable. Try signing in again.</p>
    <p>If you were signing out, your local session has ended. The identity provider may still have an active session.</p>
    <a href="/account/login" data-enhance-nav="false">Try signing in again</a>
    <a href="/">Return to the home page</a>
</main>
